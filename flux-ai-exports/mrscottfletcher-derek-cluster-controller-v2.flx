"isFootprint":true,"isPcbBoardShape":false,"isThumbnail":false,"label":"C_1206_3216Metric.kicad_mod","name":"Footprint_V5","rawName":"C_1206_3216Metric.kicad_mod","storageName":"document_assets/C_1206_3216Metric-e3c49aed-be7d-e62a-1960-6829cc3b7105.kicad_mod","uid":"91a8ab5a-e0ee-e295-2476-8f80820142cc"},"d645ebe3-2bd0-0786-798f-2f0b8dac6b80":{"fileType":"svg","is3dModel":false,"isDefault":true,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":false,"label":"non-polarized-cap.svg","name":"non-polarized-cap","rawName":"non-polarized-cap.svg","storageName":"document_assets/non-polarized-cap-b2e60049-103b-98a0-cb3c-5039225c571f.svg","uid":"d645ebe3-2bd0-0786-798f-2f0b8dac6b80"}},"behaviour":"const inputTerminalElement = flux.getNodeById(\"a214c28f-a900-0902-daa0-f9ee7f72db01\"); //P1\nconst outputTerminalElement = flux.getNodeById(\"4870c028-4e30-cc64-9fd6-6de7df4b153f\"); //P2\n\nconst outputVoltage = flux.createOutputNode(\"vout\");\nconst inputVoltage = flux.createOutputNode(\"vin\");\nconst voltageDrop = flux.createOutputNode(\"vdrop\");\nconst current = flux.createOutputNode(\"I\");\n\n// Setup Event\nflux.on(\"setup\", (event) => {\n    const capacitance = flux.properties.find((prop) => prop.name === \"Capacitance\")?.value || 0.000001;\n    flux.simulationModel = {\n        type: \"capacitor\",\n        capacitance: capacitance,\n        map_input_to_terminal_uid: inputTerminalElement?.uid,\n        map_output_to_terminal_uid: outputTerminalElement?.uid,\n    };\n});\n\n// Before Event\nflux.on(\"beforeStep\", (event) => {\n    const capacitance = flux.properties.find((prop) => prop.name === \"Capacitance\")?.value || 0.000001;\n    flux.simulationModel = {\n        type: \"capacitor\",\n        capacitance: capacitance,\n    };\n});\n\n// Calculation Event\nflux.on(\"afterStep\", (event) => {\n    \n    outputVoltage.name = \"VP2\";\n    outputVoltage.value = Number(outputTerminalElement?.voltage);\n    outputVoltage.unit = \"V\";\n    outputVoltage.displayInline = !!outputTerminalElement?.voltage;\n    \n    inputVoltage.name = \"VP1\";\n    inputVoltage.value = Number(inputTerminalElement?.voltage);\n    inputVoltage.unit = \"V\";\n    inputVoltage.displayInline = !!inputTerminalElement?.voltage;\n\n    current.name = \"I\";\n    current.value = Number(inputTerminalElement?.current);\n    current.unit = \"A\";\n    current.displayInline = !!inputTerminalElement?.current;\n\n    voltageDrop.name = \"Vdrop\";\n    voltageDrop.unit =\"V\";\n    voltageDrop.value = Number(Math.abs(outputTerminalElement?.voltage - inputTerminalElement?.voltage));\n    voltageDrop.displayInLine = true\n\n    flux.outputs = [inputVoltage, outputVoltage, voltageDrop, current];\n});","behaviour_has_errors":false,"behaviour_is_derived":false,"controls":{"_dataStructureIsArray":true},"created_at":1680689440099,"description":"±10% 1uF 25V Ceramic Capacitor X7R 1206 (3216 Metric) #CommonPartsLibrary #Capacitor #M325350","document_import_uid":"478700e0-3126-5f03-701e-ab1b73756f39","extracted_element_cache":{"4870c028-4e30-cc64-9fd6-6de7df4b153f":{"diagram_position":{"flip":false,"orientation":0,"scene_cursor_position":true,"x":-20.400000000000006,"y":24.600000000000016},"label":"P2","part_version_data_cache":{"name":"Terminal","part_uid":"835bf3e1-33dd-41bb-a166-c0a31607d645","version":"HEAD"},"properties":{"designator_prefix":{"name":"Designator Prefix","value":"P"},"part_type":{"name":"Part Type","value":"Terminal"},"pin_number":{"name":"Pin Number","value":"2"},"pin_type":{"name":"Pin Type","value":"Unspecified"},"symbol_pin_position":{"name":"Symbol Pin Position","value":{"data":{"x":16,"y":0},"type":"vector2"}},"terminal_order":{"name":"Terminal Order","value":""}}},"a214c28f-a900-0902-daa0-f9ee7f72db01":{"diagram_position":{"flip":false,"orientation":0,"scene_cursor_position":true,"x":-84.4,"y":24.6},"label":"P1","part_version_data_cache":{"name":"Terminal","part_uid":"835bf3e1-33dd-41bb-a166-c0a31607d645","version":"HEAD"},"properties"