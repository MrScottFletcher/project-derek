m PCB","order":2,"uid":"a0ca2547-f2a3-374d-819c-a2e00cf30ab4","unit":"","value":"true"},"f64359ef-cc85-48b7-be7b-96ceba5873b0":{"name":"Designator Prefix","order":3,"uid":"f64359ef-cc85-48b7-be7b-96ceba5873b0","unit":"","value":"Net"}},"roles":{"0338f920-f103-45be-9462-2cae879caa37":{"created_at":1650554042400,"permission_type":3,"updated_at":1650554042400,"user_uid":"0338f920-f103-45be-9462-2cae879caa37"}},"symbol_resource_file":"document_assets/portal-symbol-90f130a8-1e29-4585-a92a-e207ef2f5e65.svg","terminals":{"52f64ac9-5d01-d42d-9ddc-7c616f6aa0c0":{"name":"P1","position":{"x":16,"y":0},"type":"","uid":"52f64ac9-5d01-d42d-9ddc-7c616f6aa0c0"}},"version":"1a4c009c-911d-4f05-ab49-82730c0c1fa8"},"properties":{"532e3784-f32d-6853-ad7f-cfc19c6fd6a9":{"name":"Part Type","order":0,"uid":"532e3784-f32d-6853-ad7f-cfc19c6fd6a9","unit":"","value":"Portal"},"84f24716-0a83-28f1-b96b-d7b8552c405c":{"name":"Exclude from BOM","order":1,"uid":"84f24716-0a83-28f1-b96b-d7b8552c405c","unit":"","value":"true"},"a0ca2547-f2a3-374d-819c-a2e00cf30ab4":{"name":"Exclude from PCB","order":2,"uid":"a0ca2547-f2a3-374d-819c-a2e00cf30ab4","unit":"","value":"true"},"f64359ef-cc85-48b7-be7b-96ceba5873b0":{"name":"Designator Prefix","order":3,"uid":"f64359ef-cc85-48b7-be7b-96ceba5873b0","unit":"","value":"Net"}},"symbol_placements":{"MAIN":{"orientation":3.141592653589793,"x":662,"y":-4917.8}},"uid":"219501f6-32a1-4dcc-8de5-fa44f13f3332","updated_at":1781828521926},"21eb9683-79c2-4f69-b4e2-38c5009237b9":{"created_at":1781828344657,"diagram_position":{"x":0,"y":0},"label":"TP16","owner_uid":"ZlptFyOgRpgjoGMu10HDsDK5rgO2","part_uid":"cc313bba-fef2-4bbe-97b1-3f73a00a1c2d","part_version":"c476ed14-e8a6-4fc4-8762-2d33480ede7b","part_version_data_cache":{"assets":{"ad78f435-d26e-4ed3-a960-33e3673a3999":{"fileType":"svg","is3dModel":false,"isDefault":true,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":true,"label":"test-point.svg","name":"test-point","rawName":"testpoint.svg","storageName":"document_assets/testpoint-5c6338c0-265b-4a50-985b-029a00fe7f17.svg","uid":"ad78f435-d26e-4ed3-a960-33e3673a3999"}},"behaviour":"const terminalPadId = \"e9cbb998-688e-40c0-820b-08a1f688dcc6\"; // This has two nodes, one in schematic and for PCB. We only want the PCB node\nconst silkCircleId = \"a3e22c3e-0ca0-44fa-8711-8644c5a86e41\";\nconst silkTextId = \"087763aa-d4a5-492b-9426-ff893056220a\";\n\n// First cast to unknown, then to BaseNodeMixin\nconst terminalPadNode = flux.nodes.find((node) => {\n    const n = node as unknown as BaseNodeMixin; // Cast to unknown first, then to BaseNodeMixin\n    return n.id === terminalPadId && n.type === \"pcbLayoutNode\";\n}) as PcbLayoutNode | undefined;\n\nconst silkCircleNode = flux.getNodeById(silkCircleId) as PcbLayoutNode;\nconst textNodePosition = flux.getNodeById(silkTextId) as PcbLayoutNode;\n\n\n// Check if both terminalPadNode, silkCircleNode, textNodePosition are defined\nif (terminalPadNode && silkCircleNode && textNodePosition) {\n    const sizeRuleOfThePad = terminalPadNode.rules.find((rule) => rule.key === \"size\");\n    const sizeRuleOfTheCircleSilk = silkCircleNode.rules.find((rule) => rule.key === \"size\");\n    const positionRuleOfTheTextSilk = textNodePosition.rules.find((rule) => rule.key === \"positionY\");\n\n    flux.on(\"setup\", () => {\n        const property = flux.properties.find((prop) => prop.name === \"Testpoint Size\");\n        if (property) {\n            changeThePadSize(property.value);\n        };\n    });\n\n    flux.on(\"propertyChange\", (event: PropertyChangeEvent) => {\n        if (event.property_name === \"Testpoint Size\") {\n            changeThePadSize(event.value);\n        };\n    });\n\n    function changeThePadSize(newSelectedValue: any) {\n        // Check if newSelectedValue is null, undefined, or empty, and set defaults if so\n        if (!newSelectedValue || newSelectedValue === \"\") {\n            newSelectedValue = \"1\"; // Default value for pad and text position Y\n        };\n\n        const newValue = parseFloat(newSelectedValue);\n\n        if (newValue >= 0.5 && newValue <= 10) {  // Ensure that the value is within the 1 to 10 range\n            if (sizeRuleOfThePad && sizeRuleOfTheCircleSilk && positionRuleOfTheTextSilk) {\n                // Update the pad size and silk circle size based on the property value\n                sizeRuleOfThePad.value = newValue.toString();\n                sizeRuleOfTheCircleSilk.value = (newValue + 0.5).toString();\n\n                // Update the Y position\n                const positionY = newValue / 2 + 1.5;  \n                positionRuleOfTheTextSilk.value = positionY.toString();\n            };\n        };\n    };\n};","behaviour_has_errors":false,"behaviour_is_derived":false,"controls":{"_dataStructureIsArray":true},"created_at":1781027472210,"description":"This is a generic test point with a circular pad, used to either monitor the state of the circuitry or to inject test signals, and debugging during development. The footprint size is selectable.\n\nStandard SMD test point size available: 0.5mm, 0.6mm, 0.7mm, 0.8mm, 0.9mm, 1.0mm, 2.0mm, 3.00mm, 4.00mm, 5.00mm, 6.00mm, 7.00mm","document_import_uid":"8db26db2-a266-470f-b953-6d09b4b44ef0","extracted_element_cache":{"e9cbb998-688e-40c0-820b-08a1f688dcc6":{"diagram_position":{"flip":false,"orientation":0,"scene_cursor_position":true,"x":9,"y":17.5},"label":"P1","part_version_data_cache":{"name":"Terminal","part_uid":"835bf3e1-33dd-41bb-a166-c0a31607d645","version":"HEAD"},"properties":{"designator_prefix":{"name":"Designator Prefix","value":"P"},"part_type":{"name":"Part Type","value":"Terminal"},"pin_number":{"name":"Pin Number","value":"1"},"pin_type":{"name":"Pin Type","value":"Unspecified"},"symbol_pin_position":{"name":"Symbol Pin Position","value":{"data":{"x":0,"y":-10},"type":"vector2"}},"terminal_order":{"name":"Terminal Order","value":""}}}},"has_custom_name":true,"is_original":true,"name":"Generic Testpoint","owner_uid":"BvvmC