  <Capability Min="0" Max="127">Normal status interval</Capability>
  <Capability Min="128" Max="255">Request immediate status packet</Capability>
 </Channel>
 <Channel Name="Discovery" Default="0">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="0" Max="127">Normal command</Capability>
  <Capability Min="128" Max="255">Discovery command</Capability>
 </Channel>
 <Channel Name="Audio A Track MSB" Default="0">
