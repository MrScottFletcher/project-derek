	)
	(text "Arduino GPIO assignments: ID0..3=4,5,6,7; SDA=8; SCL=9; LED_DATA=10; PIR L/C/R=11,12,13; PCA_OE=14; DF2 TX/RX=15/16; DF1 TX/RX=17/18."
