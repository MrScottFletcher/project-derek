":2,"uid":"4e874a21-7855-4a92-ae21-222589bfffae","value":"0.1"}},"type":"circle","uid":"a3e22c3e-0ca0-44fa-8711-8644c5a86e41"},"e9cbb998-688e-40c0-820b-08a1f688dcc6":{"name":"P1","parentUid":"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint.Pads","pcbNodeRuleSet":{"padShape":{"key":"padShape","order":2,"uid":"4c46424d-18a7-49ef-8c8a-2358df1d5c65","value":"circular"},"size":{"key":"size","order":2,"uid":"48957c7e-5271-4483-9c06-c9c6ee95de43","value":"0.5"}},"terminalId":"1","type":"pad","uid":"e9cbb998-688e-40c0-820b-08a1f688dcc6"}},"pcbLayoutRuleSets":{},"preview_image":"document_assets/testpoint-5c6338c0-265b-4a50-985b-029a00fe7f17.svg","properties":{"36048bcc-a954-4204-8d53-721a7ea1ed0a":{"customAutocompleteOptions":{"0":"0.5","1":"0.6","2":"0.7","3":"0.8","4":"0.9","5":"1","6":"2","7":"3","8":"4","9":"5","10":"6","11":"7","_dataStructureIsArray":true},"name":"Testpoint Size","order":1,"uid":"36048bcc-a954-4204-8d53-721a7ea1ed0a","value":"0.5"},"563294b3-9753-4c5a-9246-8082f3cf03d3":{"isSetBySystem":false,"name":"Part Type","order":2,"uid":"563294b3-9753-4c5a-9246-8082f3cf03d3","unit":"","value":"Test Point"},"8a37006c-5b00-471a-a7d5-47758ae6f98d":{"name":"Designator Prefix","order":1,"uid":"8a37006c-5b00-471a-a7d5-47758ae6f98d","unit":"","value":"TP"}},"roles":{"0338f920-f103-45be-9462-2cae879caa37":{"account_type":"user","account_uid":"0338f920-f103-45be-9462-2cae879caa37","created_at":1743014897144,"permission":"view","permission_type":2,"updated_at":1743014897145,"user_uid":"0338f920-f103-45be-9462-2cae879caa37"},"AuZZV45bT6ZcQCayxjDcBMvEe2s1":{"account_type":"user","account_uid":"AuZZV45bT6ZcQCayxjDcBMvEe2s1","created_at":1725640898237,"permission":"edit","permission_type":1,"updated_at":1725640898237,"user_uid":"AuZZV45bT6ZcQCayxjDcBMvEe2s1"},"VekHpEpx58QRHsSyDKhDYeODReN2":{"account_type":"user","account_uid":"VekHpEpx58QRHsSyDKhDYeODReN2","created_at":1725658869332,"permission":"view","permission_type":2,"updated_at":1725658869332,"user_uid":"VekHpEpx5