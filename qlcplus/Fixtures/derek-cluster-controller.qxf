 </Channel>
 <Channel Name="Apply Outputs" Default="255">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="0" Max="127">Do not apply Derek output channels</Capability>
  <Capability Min="128" Max="255">Apply Derek output channels</Capability>
 </Channel>
 <Channel Name="Emergency Hide" Default="0">
