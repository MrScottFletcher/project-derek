and beyond 🚀","behaviour_has_errors":false,"behaviour_is_derived":false,"controls":{"_dataStructureIsArray":true},"created_at":1781828344326,"description":"Connectivity options include 802.11 b/g/n Wi-Fi, Bluetooth® 5 (BLE), and BLE 5 Mesh support, operating at 2.4GHz for seamless wireless communication. The board is equipped with 2MB PSRAM and 384KB ROM, alongside a wide range of I/O interfaces, including 45 GPIOs, 4 x SPI, 3 x UART, 2 x I2C, 14 x touch pins, 2 x I2S, RMT, LED PWM, USB-OTG, TWAI, and 2 x 12-bit ADCs. It also features DVP for expanded functionality, making it a versatile solution for IoT and embedded applications.","document_import_uid":"20453990-e0ea-491b-911c-fb498049cf11","extracted_element_cache":{"01801757-0f66-4041-bbc2-5e15585e8bfc":{"diagram_position":{"flip":false,"x":129,"y":-71},"label":"GPIO37","part_version_data_cache":{"name":"Terminal","part_uid":"835bf3e1-33dd-41bb-a166-c0a31607d645","version":"HEAD"},"properties":{"6f977a20-e9f2-4be7-b3df-c8d77503dd66":{"name":"Section","value":"Analog"},"8c7ab8a0-1997-4c7e-a5be-38c4bc3a81ca":{"name":"Pin Orientation","value":"Left"},"ae591e7c-f764-4c86-90ee-ab32bf13ec82":{"name":"Pin Group","value":"ADC"},"be6d775d-a5e1-4d03-b090-bdedf6854423":{"name":"Symbol Style","value":"Parametric"},"designator_prefix":{"name":"Designator Prefix","value":"P"},"part_type":{"name":"Part Type","value":"Terminal"},"pin_number":{"name":"Pin Number","value":"GPIO37"},"pin_type":{"name":"Pin Type","value":"Bi-Directional"},"symbol_pin_position":{"name":"Symbol Pin Position","value":{"data":{"x":129.5,"y":-99.5},"type":"vector2"}},"terminal_order":{"name":"Terminal Order","value":""}}},"08fba8bb-ab50-45cd-b0dd-b982f06491bc":{"diagram_position":{"flip":false,"x":129,"y":-14},"label":"GPIO47","part_version_data_cache":{"name":"Terminal","part_uid":"835bf3e1-33dd-41bb-a166-c0a31607d645","version":"HEAD"},"properties":{"6959f476-188b-4984-ac45-52e05c7323d1":{"name":"Pin Orientation","value":"Right"},"7e0c110b-b441-46e1-a1