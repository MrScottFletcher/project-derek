0"}},"version":"1a4c009c-911d-4f05-ab49-82730c0c1fa8"},"properties":{"532e3784-f32d-6853-ad7f-cfc19c6fd6a9":{"name":"Part Type","order":0,"uid":"532e3784-f32d-6853-ad7f-cfc19c6fd6a9","unit":"","value":"Portal"},"84f24716-0a83-28f1-b96b-d7b8552c405c":{"name":"Exclude from BOM","order":1,"uid":"84f24716-0a83-28f1-b96b-d7b8552c405c","unit":"","value":"true"},"a0ca2547-f2a3-374d-819c-a2e00cf30ab4":{"name":"Exclude from PCB","order":2,"uid":"a0ca2547-f2a3-374d-819c-a2e00cf30ab4","unit":"","value":"true"},"f64359ef-cc85-48b7-be7b-96ceba5873b0":{"name":"Designator Prefix","order":3,"uid":"f64359ef-cc85-48b7-be7b-96ceba5873b0","unit":"","value":"Net"}},"symbol_placements":{"MAIN":{"orientation":0,"x":2890.5,"y":-1175.4}},"uid":"3db15b00-c189-464e-91b1-b4f2cd50cdcd","updated_at":1781828521482},"3f382279-c9c5-4ab1-b770-8ba9d3d662ed":{"created_at":1781828344655,"diagram_position":{"x":0,"y":0},"label":"TP6","owner_uid":"ZlptFyOgRpgjoGMu10HDsDK5rgO2","part_uid":"cc313bba-fef2-4bbe-97b1-3f73a00a1c2d","part_version":"c476ed14-e8a6-4fc4-8762-2d33480ede7b","part_version_data_cache":{"assets":{"ad78f435-d26e-4ed3-a960-33e3673a3999":{"fileType":"svg","is3dModel":false,"isDefault":true,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":true,"label":"test-point.svg","name":"test-point","rawName":"testpoint.svg","storageName":"document_assets/testpoint-5c6338c0-265b-4a50-985b-029a00fe7f17.svg","uid":"ad78f435-d26e-4ed3-a960-33e3673a3999"}},"behaviour":"const terminalPadId = \"e9cbb998-688e-40c0-820b-08a1f688dcc6\"; // This has two nodes, one in schematic and for PCB. We only want the PCB node\nconst silkCircleId = \"a3e22c3e-0ca0-44fa-8711-8644c5a86e41\";\nconst silkTextId = \"087763aa-d4a5-492b-9426-ff893056220a\";\n\n// First cast to unknown, then to BaseNodeMixin\nconst terminalPadNode = flux.nodes.find((node) => {\n    const n = node as unknown as BaseNodeMixin; // Cast to unknown first, then to BaseNodeMixin\n    return n.id === terminalPadId && n.type === \"pcbLayoutNode\";\n}) as PcbLayoutNode | undefined;\n\nconst silkCircleNode = flux.getNodeById(silkCircleId) as PcbLayoutNode;\nconst textNodePosition = flux.getNodeById(silkTextId) as PcbLayoutNode;\n\n\n// Check if both terminalPadNode, silkCircleNode, textNodePosition are defined\nif (terminalPadNode && silkCircleNode && textNodePosition) {\n    const sizeRuleOfThePad = terminalPadNode.rules.find((rule) => rule.key === \"size\");\n    const sizeRuleOfTheCircleSilk = silkCircleNode.rules.find((rule) => rule.key === \"size\");\n    const positionRuleOfTheTextSilk = textNodePosition.rules.find((rule) => rule.key === \"positionY\");\n\n    flux.on(\"setup\", () => {\n        const property = flux.properties.find((prop) => prop.name === \"Testpoint Size\");\n        if (property) {\n            changeThePadSize(property.value);\n        };\n    });\n\n    flux.on(\"propertyChange\", (event: PropertyChangeEvent) => {\n        if (event.property_name === \"Testpoint Size\") {\n            changeThePadSize(event.value);\n        };\n    });\n\n    function changeThePadSize(newSelectedValue: any) {\n        // Check if newSelectedValue is null, undefined, or empty, and set defaults if so\n        if (!newSelectedValue || newSelectedValue === \"\") {\n            newSelectedValue = \"1\"; // Default value for pad and text position Y\n        };\n\n        const newValue = parseFloat(newSelectedValue);\n\n        if (newValue >= 0.5 && newValue <= 10) {  // Ensure that the value is within the 1 to 10 range\n            if (sizeRuleOfThePad && sizeRuleOfTheCircleSilk && positionRuleOfTheTextSilk) {\n                // Update the pad size and silk circle size based on the property value\n                sizeRuleOfThePad.value = newValue.toString();\n                sizeRuleOfTheCircleSilk.value = (newValue + 0.5).toString();\n\n                // Update the Y position\n                const positionY = newValue / 2 + 1.5;  \n                positionRuleOfTheTextSilk.value = positionY.toString();\n            };\n        };\n    };\n};","behaviour_has_errors":false,"behaviour_is_derived":false,"controls":{"_dataStructureIsArray":true},"created_at":1781027472210,"description":"This is a generic test point with a circular pad, used to either monitor the state of the circuitry or to inject test signals, and debugging during development. The footprint size is selectable.\n\nStandard SMD test point size available: 0.5mm, 0.6mm, 0.7mm, 0.8mm, 0.9mm, 1.0mm, 2.0mm, 3.00mm, 4.00mm, 5.00mm, 6.00mm, 7.00mm","document_import_uid":"8db26db2-a266-470f-b953-6d09b4b44ef0","extracted_element_cache":{"e9cbb998-688e-40c0-820b-08a1f688dcc6":{"diagram_position":{"flip":false,"orientation":0,"scene_cursor_position":true,"x":9,"y":17.5},"label":"P1","part_version_data_cache":{"name":"Terminal","part_uid":"835bf3e1-33dd-41bb-a166-c0a31607d645","version":"HEAD"},"properties":{"designator_prefix":{"name":"Designator Prefix","value":"P"},"part_type":{"name":"Part Type","value":"Terminal"},"pin_number":{"name":"Pin Number","value":"1"},"pin_type":{"name":"Pin Type","value":"Unspecified"},"symbol_pin_position":{"name":"Symbol Pin Position","value":{"data":{"x":0,"y":-10},"type":"vector2"}},"terminal_order":{"name":"Terminal Order","value":""}}}},"has_custom_name":true,"is_original":true,"name":"Generic Testpoint","owner_uid":"BvvmCewoPEamxFYjB0c5ERKB6rt1","part_uid":"cc313bba-fef2-4bbe-97b1-3f73a00a1c2d","pcbLayoutNodes":{"087763aa-d4a5-492b-9426-ff893056220a":{"name":"","parentUid":"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint","pcbNodeRuleSet":{"content":{"key":"content","order":2,"uid":"ff3823e9-d548-4a33-accc-e2ea1157dcce","value":"=this.element.designator"},"fontSize":{"key":"fontSize","order":4,"uid":"b79b69ad-6a6f-4682-9307-e1964af98167","value":"0.8"},"positionY":{"key":"positionY","order":3,"uid":"30601dfc-7bb3-4e48-acb9-a891a4e02bcd","value":"1.3"},"textAlign":{"key":"textAlign","order":3,"uid":"883cb94a-abc1-417b-ba83-4c7f12162bb0","value":"center"}},"type":"text","uid":"087763aa-d4a5-492b-9426-ff893056220a"},"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint":{"name":"Footprint","parentUid":"ROOT","pcbNodeRuleSet":{},"type":"footprint","uid":"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint"},"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint.Pads":{"name":"Pads","parentUid":"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint","pcbNodeRuleSet":{},"type":"container","uid":"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint.Pads"},"ROOT":{"name":"Root","parentUid":"PARENT_OF_ROOT","pcbNodeRuleSet":{},"type":"root","uid":"ROOT"},"a3e22c3e-0ca0-44fa-8711-8644c5a86e41":{"name":"Circle Shape","parentUid":"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint","pcbNodeRuleSet":{"size":{"key":"size","order":2,"uid":"853413f6-037a-43c5-a55c-734e60be1141","value":"1"},"strokeWidth":{"key":"strokeWidth","order":2,"uid":"4e874a21-7855-4a92-ae21-222589bfffae","value":"0.1"}},"type":"circle","uid":"a3e22c3e-0ca0-44fa-8711-8644c5a86e41"},"e9cbb998-688e-40c0-820b-08a1f688dcc6":{"name":"P1","parentUid":"8db26db2-a266-470f-b953-6d09b4b44ef0.defaultFootprint.Pads","pcbNodeRuleSet":{"padShape":{"key":"padShape","order":2,"uid":"4c46424d-18a7-49ef-8c8a-2358df1d5c65","value":"circular"},"size":{"key":"size","order":2,"uid":"48957c7e-5271-4483-9c06-c9c6ee95de43","value":"0.5"}},"terminalId":"1","type":"pad","uid":"e9cbb998-688e-40c0-820b-08a1f688dcc6"}},"pcbLayoutRuleSets":{},"preview_image":"document_assets/testpoint-5c6338c0-265b-4a50-985b-029a00fe7f17.svg","properties":{"36048bcc-a954-4204-8d53-721a7ea1ed0a":{"customAutocompleteOptions":{"0":"0.5","1":"0.6","2":"0.7","3":"0.8","4":"0.9","5":"1","6":"2","7":"3","8":"4","9":"5","10":"6","11":"7","_dataStructureIsArray":true},"name":"Testpoint Size","order":1,"uid":"36048bcc-a954-4204-8d53-721a7ea1ed0a","value":"0.5"},"563294b3-9753-4c5a-9246-8082f3cf03d3":{"isSetBySystem":false,"name":"Part Type","order":2,"uid":"563294b3-9753-4c5a-9246-8082f3cf03d3","unit":"","value":"Test P