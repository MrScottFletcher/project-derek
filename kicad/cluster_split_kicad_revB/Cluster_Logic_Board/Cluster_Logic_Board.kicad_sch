	(text "5V/VIN <- +5V_LOGIC\n3V3 -> +3V3_LOGIC\nSDA -> I2C_SDA\nSCL -> I2C_SCL\nGPIO -> LED_DATA_3V3\nGPIO -> PCA_OE_N\nUART1 -> DFPLAYER 1\nUART2 -> DFPLAYER 2\nGPIOs -> PIR LEFT/CENTER/RIGHT\nGPIOs -> ID0..ID3"
