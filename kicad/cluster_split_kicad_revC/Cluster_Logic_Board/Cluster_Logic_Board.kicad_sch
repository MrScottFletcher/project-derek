	(text "U1 pin numbers are literal DevKit header locations (J1.x / J3.x). 5V = U1:J1.21. GND = U1:J1.22, J3.1, J3.21, J3.22. 3V3 = U1:J1.1/J1.2."
		(exclude_from_sim no)
		(at 20 22 0)
