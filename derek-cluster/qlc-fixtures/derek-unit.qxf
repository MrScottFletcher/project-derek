<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5</Version>
  <Author>Project Derek</Author>
 </Creator>
 <Manufacturer>Project Derek</Manufacturer>
 <Model>Derek Unit</Model>
 <Type>Moving Head</Type>
 <Channel Name="Pan" Default="90">
  <Group Byte="0">Pan</Group>
  <Capability Min="0" Max="9">Clamped to left limit</Capability>
  <Capability Min="10" Max="90">Look left to center</Capability>
  <Capability Min="91" Max="170">Look center to right</Capability>
  <Capability Min="171" Max="255">Clamped to right limit</Capability>
 </Channel>
 <Channel Name="Lift" Default="0">
  <Group Byte="0">Tilt</Group>
  <Capability Min="0" Max="0">Hidden</Capability>
  <Capability Min="1" Max="136">Raise through default can travel</Capability>
  <Capability Min="137" Max="170">Upper travel if can profile allows it</Capability>
  <Capability Min="171" Max="255">Clamped to configured lift limit</Capability>
 </Channel>
 <Channel Name="Eye Red" Default="0">
  <Group Byte="0">Intensity</Group>
  <Colour>Red</Colour>
  <Capability Min="0" Max="255">Eye red intensity</Capability>
 </Channel>
 <Channel Name="Eye Green" Default="0">
  <Group Byte="0">Intensity</Group>
  <Colour>Green</Colour>
  <Capability Min="0" Max="255">Eye green intensity</Capability>
 </Channel>
 <Channel Name="Eye Blue" Default="0">
  <Group Byte="0">Intensity</Group>
  <Colour>Blue</Colour>
  <Capability Min="0" Max="255">Eye blue intensity</Capability>
 </Channel>
 <Channel Name="Can Red" Default="0">
  <Group Byte="0">Intensity</Group>
  <Colour>Red</Colour>
  <Capability Min="0" Max="255">Can interior red intensity</Capability>
 </Channel>
 <Channel Name="Can Green" Default="0">
  <Group Byte="0">Intensity</Group>
  <Colour>Green</Colour>
  <Capability Min="0" Max="255">Can interior green intensity</Capability>
 </Channel>
 <Channel Name="Can Blue" Default="0">
  <Group Byte="0">Intensity</Group>
  <Colour>Blue</Colour>
  <Capability Min="0" Max="255">Can interior blue intensity</Capability>
 </Channel>
 <Channel Name="Exterior Red" Default="0">
  <Group Byte="0">Intensity</Group>
  <Colour>Red</Colour>
  <Capability Min="0" Max="255">Exterior red intensity</Capability>
 </Channel>
 <Channel Name="Exterior Green" Default="0">
  <Group Byte="0">Intensity</Group>
  <Colour>Green</Colour>
  <Capability Min="0" Max="255">Exterior green intensity</Capability>
 </Channel>
 <Channel Name="Exterior Blue" Default="0">
  <Group Byte="0">Intensity</Group>
  <Colour>Blue</Colour>
  <Capability Min="0" Max="255">Exterior blue intensity</Capability>
 </Channel>
 <Mode Name="11 Channel">
  <Channel Number="0">Pan</Channel>
  <Channel Number="1">Lift</Channel>
  <Channel Number="2">Eye Red</Channel>
  <Channel Number="3">Eye Green</Channel>
  <Channel Number="4">Eye Blue</Channel>
  <Channel Number="5">Can Red</Channel>
  <Channel Number="6">Can Green</Channel>
  <Channel Number="7">Can Blue</Channel>
  <Channel Number="8">Exterior Red</Channel>
  <Channel Number="9">Exterior Green</Channel>
  <Channel Number="10">Exterior Blue</Channel>
 </Mode>
 <Physical>
  <Bulb Type="RGB LED pixels and two servos" Lumens="0" ColourTemperature="0"/>
  <Dimensions Width="100" Height="180" Depth="100" Weight="0.5"/>
  <Lens Name="Other" DegreesMin="0" DegreesMax="360"/>
  <Focus Type="Head" PanMax="160" TiltMax="170"/>
  <Technical PowerConsumption="10" DmxConnector="Wireless"/>
