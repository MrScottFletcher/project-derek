n_type":"Unspecified","symbol_pin_position":{"data":{"x":0,"y":9},"type":"vector2"},"terminal_order":""}}},"has_custom_name":true,"is_original":true,"name":"Ground","owner_uid":"BvvmCewoPEamxFYjB0c5ERKB6rt1","part_uid":"c2e41937-4268-256c-7ae9-cb8cfb60aed3","pcbLayoutNodes":{},"pcbLayoutRuleSets":{},"preview_image":"document_assets/ground-420b199c-b591-be2b-99f1-088328ac6a43.svg","properties":{"ad67163f-862e-28f5-0706-d72a98e66064":{"name":"Part Type","order":1,"uid":"ad67163f-862e-28f5-0706-d72a98e66064","unit":"","value":"Ground"},"ca976aa3-af77-e876-7d14-cba051ebd160":{"name":"Exclude from BOM","order":0,"uid":"ca976aa3-af77-e876-7d14-cba051ebd160","unit":"","value":"true"}},"roles":{"0338f920-f103-45be-9462-2cae879caa37":{"created_at":1625653968074,"permission_type":3,"updated_at":1625653968077,"user_uid":"0338f920-f103-45be-9462-2cae879caa37"},"AuZZV45bT6ZcQCayxjDcBMvEe2s1":{"created_at":1596130410275,"permission_type":1,"updated_at":1596130410275,"user_uid":"AuZZV45bT6ZcQCayxjDcBMvEe2s1"},"Bn6axiYJcxQUzPpM4dk8HVKptHH3":{"created_at":1596130410275,"permission_type":1,"updated_at":1596130410275,"user_uid":"Bn6axiYJcxQUzPpM4dk8HVKptHH3"}},"simulation_hash":"733ccd22c2e4b0b3f8a98b4b80434bd2","symbol_resource_file":"document_assets/ground-420b199c-b591-be2b-99f1-088328ac6a43.svg","terminals":{"78e6da6c-8b6b-b7dc-d8fd-bbf3d2e8bf9d":{"name":"GND","position":{"x":0,"y":9},"type":"Unspecified","uid":"78e6da6c-8b6b-b7dc-d8fd-bbf3d2e8bf9d"}},"version":"8ef1611b-98c1-4c16-59c7-6d6b831060fd"},"properties":{"ad67163f-862e-28f5-0706-d72a98e66064":{"name":"Part Type","order":1,"uid":"ad67163f-862e-28f5-0706-d72a98e66064","unit":"","value":"Ground"},"ca976aa3-af77-e876-7d14-cba051ebd160":{"name":"Exclude from BOM","order":0,"uid":"ca976aa3-af77-e876-7d14-cba051ebd160","unit":"","value":"true"}},"symbol_placements":{"MAIN":{"orientation":0,"x":719,"y":-1170.4}},"uid":"76f5a626-38db-4d65-8a41-4786747530d9","updated_at":1781828434880},"771b0d17-08f1-4121-a3cb-7cde20f11a27":{"created_at":1781828344656,"diagram_position":{"x":0,"y":0},"label":"TP12","owner_uid":"ZlptFyOgRpgjoGMu10HDsDK5rgO2","part_uid":"cc313bba-fef2-4bbe-97b1-3f73a00a1c2d","part_version":"c476ed14-e8a6-4fc4-8762-2d33480ede7b","part_version_data_cache":{"assets":{"ad78f435-d26e-4ed3-a960-33e3673a3999":{"fileType":"svg","is3dModel":false,"isDefault":true,"isFootprint":false,"isPcbBoardShape":false,"isThumbnail":true,"label":"test-point.svg","name":"test-point","rawName":"testpoint.svg","storageName":"document_assets/testpoint-5c6338c0-265b-4a50-985b-029a00fe7f17.svg","uid":"ad78f435-d26e-4ed3-a960-33e3673a3999"}},"behaviour":"const terminalPadId = \"e9cbb998-688e-40c0-820b-08a1f688dcc6\"; // This has two nodes, one in schematic and for PCB. We only want the PCB node\nconst silkCircleId = \"a3e22c3e-0ca0-44fa-8711-8644c5a86e41\";\nconst silkTextId = \"087763aa-d4a5-492b-9426-ff893056220a\";\n\n// First cast to unknown, then to BaseNodeMixin\nconst terminalPadNode = flux.nodes.find((node) => {\n    const n = node as unknown as BaseNodeMixin; // Cast to unknown first, then to BaseNodeMixin\n    return n.id === terminalPadId && n.type === \"pcbLayoutNode\";\n}) as PcbLayoutNode | undefined;\n\nconst silkCircleNode = flux.getNodeById(silkCircleId) as PcbLayoutNode;\nconst textNodePosition = flux.getNodeById(silkTextId) as PcbLayoutNode;\n\n\n// Check if both terminalPadNode, silkCircleNode, textNodePosition are defined\nif (terminalPadNode && silkCircleNode && textNodePosition) {\n    const sizeRuleOfThePad = terminalPadNode.rules.find((rule) => rule.key === \"size\");\n    const sizeRuleOfTheCircleSilk = silkCircleNode.rules.find((rule) => rule.key === \"size\");\n    const positionRuleOfTheTextSilk = textNodePosition.rules.find((rule) => rule.key === \"positionY\");\n\n    flux.on(\"setup\", () => {\n        const property = flux.properties.find((prop) => prop.name === \"Testpoint Size\");\n        if (property) {\n            changeThePadSize(property.value);\n        };\n    });\n\n    flux.on(\"propertyChange\", (event: PropertyChangeEvent) => {\n        if (event.property_name === \"Testpoint Size\") {\n            changeThePadSize(event.value);\n        };\n    });\n\n    function changeThePadSize(newSelectedValue: any) {\n        // Check if newSelectedValue is null, undefined, or empty, and set defaults if so\n        if (!newSelectedValue || newSelectedValue === \"\") {\n            newSelectedValue = \"1\"; // Default value for pad and text position Y\n        };\n\n        const newValue = parseFloat(newSelectedValue);\n\n        if (newValue >= 0.5 && newValue <= 10) {  // Ensure that the value is within the 1 to 10 range\n            if (sizeRuleOfThePad && sizeRuleOfTheCircleSilk && positionRuleOfTheTextSilk) {\n                // Update the pad size and silk circle size based on the property value\n                sizeRuleOfThePad.value = newValue.toString();\n                sizeRuleOfTheCircleSilk.value = (newValue + 0.5).toString();\n\n                // Update the Y position\n                const positionY = newValue / 2 + 1.5;  \n                positionRuleOfTheTextSilk.value = positionY.toString();\n            };\n        };\n    };\n};","behaviour_has_errors":false,"behaviour_is_derived":false,"controls":{"_dataStructureIsArray":true},"created_at":1781027472210,"description":"This is a generic test point with a circular pad, used to either monitor the state of the circuitry or to inject test signals, and debugging during development. The footprint size is selectable.\n\nStandard SMD test point size available: 0.5mm, 0.6mm, 0.7mm, 0.8mm, 0.9mm, 1.0mm, 2.0mm, 3.00mm, 4.00mm, 5.00mm, 6.00mm, 7.00mm","document_import_uid":"8db26db2-a266-470f-b953-6d09b4b44ef0","extracted_element_cache":{"e9cbb998-688e-40c0-820b-08a1f688dcc6":{"diagram_position":{"flip":false,"orientation":0,"scene_cursor_position":true,"x":9,"y":17.5},"label":"P1","part_version_data_cache":{"name":"Terminal","part_uid":"835bf3e1-33dd-41bb-a166-c0a31607d6